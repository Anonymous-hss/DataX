# ==============================================================================
# DataX Enterprise Environment Configuration Template
# Copy to .env and customize for your deployment environment
# ==============================================================================

# Core Service Configuration
PORT=8003
ENVIRONMENT=production
DATAX_VAULT_DIR=/app/data
LOG_LEVEL=INFO

# Cryptographic Master Key for Vault & Credentials
DATAX_MASTER_KEY=g3Q6M9vP8xK2rT5wY7zB1cE4fH6jL0nS2uV4xZ6aC8=

# JWT Authentication
JWT_EXPIRATION_HOURS=24

# Primary Metadata & Target Database (PostgreSQL)
POSTGRES_DB=datax_db
POSTGRES_USER=datax_admin
POSTGRES_PASSWORD=DataX_Secure_Pass_2026!
DATAX_DATABASE_URI=postgresql://datax_admin:DataX_Secure_Pass_2026!@datax-postgres:5432/datax_db
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require

# Frontend Vite API Base URL
VITE_API_BASE_URL=https://dataglow.ai/datax-api

# Optional AI Rule Synthesis (Azure OpenAI)
# If left blank, DataX automatically falls back to Offline Local Ontology Heuristics (REL-05)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://dataglow-azure-openai.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Alerts & Notifications (Slack Webhook & SMTP)
ALERT_SLACK_WEBHOOK_URL=
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=
ALERT_EMAIL_RECIPIENTS=sre-oncall@clientdomain.com

# Required shared JWT signing key; generate with: openssl rand -hex 32
# Keep the generated value private and do not commit it.
DATAX_JWT_SECRET=
