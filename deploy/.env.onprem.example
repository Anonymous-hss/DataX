# ==============================================================================
# DataX Zero-Egress On-Premises Environment Configuration
# (Task 3: Containerized Runner Package)
# ==============================================================================

# PostgreSQL On-Premises Credentials
POSTGRES_DB=datax
POSTGRES_USER=datax
POSTGRES_PASSWORD=DataX_Local_2027_Enterprise!
POSTGRES_PORT=5432

# DataX Storage URIs (Strictly Local)
DATAX_STORAGE_URI=postgresql://datax:DataX_Local_2027_Enterprise!@datax-postgres:5432/datax?sslmode=disable
DATAX_POSTGRES_URI=postgresql://datax:DataX_Local_2027_Enterprise!@datax-postgres:5432/datax?sslmode=disable

# Security Secrets (Generate using `openssl rand -hex 32`)
DATAX_JWT_SECRET=DataX_MasterSecret_OnPrem_2027_LongSecureKey!
DATAX_VAULT_DIR=/app/data

# Optional Upstream Cloud Credentials (DataX sanitizes all PII before dispatch)
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
ANTHROPIC_API_KEY=

# Local On-Prem LLM Daemon (Ollama / vLLM)
LOCAL_LLM_URL=http://host.docker.internal:11434

